{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "command": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "macos": {"$ref": "#/$defs/command"},
            "windows": {"$ref": "#/$defs/command"},
            "default": {"$ref": "#/$defs/command"}
          }
        }
      ]
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "startup_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "stability_seconds": {"type": "number", "minimum": 5},
        "shutdown_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "poll_interval_seconds": {"type": "number", "exclusiveMinimum": 0},
        "action_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "monitor_detection_timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  },
  "title": "Local Service Launcher Framework v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "launcher", "services"],
  "properties": {
    "schema_version": {"const": 1},
    "launcher": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "host": {"enum": ["127.0.0.1", "localhost"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "monitor_interval_seconds": {"type": "number", "minimum": 0.25, "maximum": 5},
        "stop_services_on_exit": {"type": "boolean"},
        "exit_when_no_clients_seconds": {"type": "number", "minimum": 0},
        "repository_check_interval_seconds": {
          "type": "number",
          "anyOf": [{"const": 0}, {"minimum": 30}]
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "project_ref", "display", "lifecycle", "health"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "category": {"enum": ["static-web", "frontend", "backend", "service"]},
          "project_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "display": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "name": {"type": "string"},
              "description": {"type": "string"},
              "name_from": {
                "type": "object", "additionalProperties": false, "required": ["file"],
                "properties": {"file": {"type": "string"}, "json_path": {"type": "string"}}
              },
              "version_from": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "file": {"type": "string"},
                  "format": {"enum": ["json", "toml"]},
                  "key_path": {"type": "string", "default": "version"},
                  "command": {"$ref": "#/$defs/command"},
                  "regex": {"type": "string"},
                  "timeout_seconds": {"type": "number", "minimum": 0.1, "maximum": 10},
                  "refresh_seconds": {"type": "number", "minimum": 5, "maximum": 86400},
                  "prefix": {"type": "string", "maxLength": 8}
                },
                "oneOf": [
                  {
                    "required": ["file"],
                    "not": {"anyOf": [
                      {"required": ["command"]}, {"required": ["regex"]},
                      {"required": ["timeout_seconds"]}, {"required": ["refresh_seconds"]}
                    ]}
                  },
                  {
                    "required": ["command", "regex"],
                    "not": {"anyOf": [
                      {"required": ["file"]}, {"required": ["format"]}, {"required": ["key_path"]}
                    ]}
                  }
                ]
              }
            },
            "anyOf": [{"required": ["name"]}, {"required": ["name_from"]}]
          },
          "lifecycle": {
            "type": "object", "additionalProperties": false, "required": ["start"],
            "properties": {
              "start": {"$ref": "#/$defs/command"},
              "stop": {"$ref": "#/$defs/command"},
              "update": {"$ref": "#/$defs/command"}
            }
          },
          "health": {
            "type": "object", "additionalProperties": false, "required": ["mode"],
            "properties": {
              "mode": {"enum": ["http", "tcp", "env", "auto", "command"]},
              "url": {"type": "string"}, "host": {"type": "string"}, "port": {"type": "integer"},
              "command": {"$ref": "#/$defs/command"},
              "timeout_seconds": {"type": "number"}, "env_file": {"type": "string"},
              "port_key": {"type": "string"}, "scheme": {"enum": ["http", "https", "tcp"]},
              "path": {"type": "string"}, "fallback_url": {"type": "string"},
              "fallback_port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "http_probe_interval_seconds": {"type": "number", "minimum": 0}
            },
            "allOf": [
              {"if": {"properties": {"mode": {"const": "http"}}}, "then": {"required": ["url"]}},
              {"if": {"properties": {"mode": {"const": "tcp"}}}, "then": {"required": ["port"]}},
              {"if": {"properties": {"mode": {"const": "env"}}}, "then": {"required": ["port_key"]}},
              {"if": {"properties": {"mode": {"const": "command"}}}, "then": {"required": ["command"]}}
            ]
          },
          "url": {
            "oneOf": [
              {"type": "string"},
              {
                "type": "object", "additionalProperties": false,
                "required": ["mode", "port_key"],
                "properties": {
                  "mode": {"const": "env"},
                  "env_file": {"type": "string"},
                  "port_key": {"type": "string"},
                  "fallback_port": {"type": "integer", "minimum": 1, "maximum": 65535},
                  "scheme": {"enum": ["http", "https"]},
                  "host": {"type": "string"},
                  "path": {"type": "string"}
                }
              }
            ]
          },
          "env": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
          "open_on_start": {"type": "boolean"},
          "validation": {"$ref": "#/$defs/validation"},
          "ports": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "mode"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "mode": {"enum": ["fixed", "env"]},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "env_file": {"type": "string"},
                "port_key": {"type": "string"},
                "fallback_port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "editable": {"const": false}
              },
              "allOf": [
                {"if": {"properties": {"mode": {"const": "fixed"}}}, "then": {"required": ["port"]}},
                {"if": {"properties": {"mode": {"const": "env"}}}, "then": {"required": ["port_key"]}}
              ]
            }
          },
          "observability": {
            "type": "object", "additionalProperties": false,
            "required": ["mode"],
            "properties": {
              "mode": {"enum": ["http", "env"]},
              "url": {"type": "string"},
              "host": {"type": "string"},
              "env_file": {"type": "string"},
              "port_key": {"type": "string"},
              "scheme": {"enum": ["http", "https"]},
              "path": {"type": "string"},
              "fallback_port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "diagnostics_path": {"type": "string"},
              "logs_path": {"type": "string"},
              "events_path": {"type": "string"},
              "open_path": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
